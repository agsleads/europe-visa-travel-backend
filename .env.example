# Europe Visa Centre — enquiry API
#
# Copy to `.env` and fill in. Every variable below is validated at boot by
# src/config/env.ts: a missing or malformed value crashes the process on
# startup rather than surfacing on the first real request.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:Posyt23%40h%21%40%23%2A@localhost:5432/evc

# Keep well under the server's max_connections, especially on a managed plan.
DATABASE_POOL_MAX=10

# false | true | no-verify
#   true      — verify the certificate chain (the correct production setting)
#   no-verify — encrypted, chain unverified. Some managed providers (Neon,
#               Supabase, RDS) sign with their own CA; a deliberate choice.
DATABASE_SSL=false
 
# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Shared secret the Next.js server sends as `x-api-key`. Must match
# ENQUIRY_API_KEY in the frontend's .env.local. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# REQUIRED in production — the process refuses to boot without it rather than
# expose an unauthenticated write endpoint.
API_KEY=

# ---------------------------------------------------------------------------
# Road Cover lead intake
# ---------------------------------------------------------------------------
# Shared secret the Road Cover site (roadcover.us) sends as
# `x-roadcover-signature` on every lead webhook. Must match WEBHOOK_SECRET in
# that site's environment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Deliberately NOT the same value as API_KEY: that key belongs to our own Next
# frontend, this one is held by a site we do not deploy. Sharing one value would
# mean rotating ours requires a release of theirs.
#
# Unlike API_KEY the process still boots without it, because the Road Cover
# webhook is one integration rather than this service's reason to exist. In
# production an unset secret rejects every lead with a 401 instead — visible
# immediately, but not an outage for enquiries.
#
# To rotate: set the new value here, restart, then update WEBHOOK_SECRET on the
# Road Cover site. Leads posted in between are rejected with a 401 and are NOT
# retried by the producer, so rotate during a quiet window.
ROADCOVER_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Final Expense Coverage lead intake
# ---------------------------------------------------------------------------
# Shared secret the Final Expense Coverage site (finalexpensecoverage.us) sends
# as `x-finalexpense-signature` from its /api/lead route. Must match
# FINALEXPENSE_WEBHOOK_SECRET in that site's environment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Its own value, not API_KEY and not the Road Cover secret, so a leak or a
# rotation of one never touches another. Blank outside production leaves the
# intake unauthenticated with a warning; in production blank rejects every lead
# with a 401. After adding it, run `npm run migrate` (migration 003 creates the
# final_expense_leads tables).
FINALEXPENSE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Senior Health Benefits lead intake
# ---------------------------------------------------------------------------
# Shared secret the Senior Health Benefits site (seniorhealthbenefits.net) sends
# as `x-seniorhealth-signature` from its /api/lead route. Must match
# SENIORHEALTH_WEBHOOK_SECRET in that site's environment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Its own value, not API_KEY and not another producer's secret, so a leak or a
# rotation of one never touches another. Blank outside production leaves the
# intake unauthenticated with a warning; in production blank rejects every lead
# with a 401. After adding it, run `npm run migrate` (migration 004 creates the
# senior_health_leads tables).
SENIORHEALTH_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Explore Auto Insurance lead intake
# ---------------------------------------------------------------------------
# Shared secret the Explore Auto Insurance site (exploreautoinsurance.com) sends
# as `x-autoinsurance-signature` from its Vercel function (api/lead.js). Must
# match AUTOINSURANCE_WEBHOOK_SECRET in that site's Vercel environment.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Its own value, not API_KEY and not another producer's secret. Blank outside
# production leaves the intake unauthenticated with a warning; in production
# blank rejects every lead with a 401. After adding it, run `npm run migrate`
# (migration 008 creates the auto_insurance_leads tables).
AUTOINSURANCE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Disability Benefit Helps lead intake
# ---------------------------------------------------------------------------
# Shared secret the Disability Benefit Helps site (the social-security repo)
# sends as `x-socialsecurity-signature` from its Vercel function (api/lead.js).
# Must match SOCIALSECURITY_WEBHOOK_SECRET in that site's Vercel environment.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Its own value, not API_KEY and not another producer's secret. Blank outside
# production leaves the intake unauthenticated with a warning; in production
# blank rejects every lead with a 401. After adding it, run `npm run migrate`
# (migration 009 creates the social_security_leads tables).
SOCIALSECURITY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Onyx utilization API
# ---------------------------------------------------------------------------
# Prefixed EVC_ on purpose. These deploy to a Railway project that already
# defines ONYX_SOURCE_ID for a different service, and an unprefixed name
# there would silently inherit that other service's source — pinging the
# wrong Onyx source with our credential, with nothing in the logs to say so.
# Do not "tidy" the prefix away.
# Used by POST /api/v1/onyx/utilization and POST /api/v1/onyx/availability,
# which forward their body to:
#   {EVC_ONYX_API_URL}/api/v1/external/organizations/{EVC_ONYX_ORGANIZATION_ID}/sources/{EVC_ONYX_SOURCE_ID}/utilization
# The key is sent as-is in the X-API-Key header. Leave it empty and the
# endpoint answers 503 without calling Onyx.
#
# /utilization returns Onyx's answer verbatim, `bid` included, and is for
# server-to-server callers only. /availability returns { available,
# phone_number } and is the one a browser may call: our buy rate must not be
# readable in a visitor's network tab. Pointing a public page at /utilization
# publishes what we pay per call.
EVC_ONYX_API_KEY=
EVC_ONYX_API_URL=https://api.onyxplatform.com
EVC_ONYX_ORGANIZATION_ID=5
EVC_ONYX_SOURCE_ID=1046
EVC_ONYX_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated origins allowed to call this API *from a browser*. Leave
# empty for the normal deployment: the browser never calls this service
# directly, only the Next.js server does, and a server-to-server caller sends
# no Origin header.
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Onyx public routes
# ---------------------------------------------------------------------------
# Per-IP, per-minute ceiling for POST /api/v1/onyx/availability and
# POST /api/v1/onyx/utilization.
#
# Both routes are UNAUTHENTICATED: their callers are static pages with no
# server of their own, so the alternative was shipping an API key that also
# unlocks /enquiries and /users. This number is therefore the whole of their
# protection, and every call spends our paid Onyx credential.
#
# /utilization returns Onyx's body verbatim - phone_number, bid, billing_type
# included - so a farmed endpoint leaks commercial terms, not just budget.
# Watch Onyx spend after launch and lower this if it is being abused.
ONYX_RATE_LIMIT_MAX=10

RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=30

# ---------------------------------------------------------------------------
# Facebook Lead Ads
# ---------------------------------------------------------------------------
# Leads from Facebook/Instagram Instant Forms are stored as enquiries with
# source = facebook. Webhook URL: https://<this API>/api/v1/meta/webhook
#
# The numeric app id (App settings > Basic).
META_APP_ID=
# App settings > Basic > App secret. Verifies every webhook delivery's
# x-hub-signature-256 and signs Graph calls (appsecret_proof). Required in
# production: without it the webhook rejects every delivery.
META_APP_SECRET=
# Any random value of 16+ characters, typed into the Meta dashboard as the
# webhook's "Verify token". Generate with: openssl rand -hex 24
META_WEBHOOK_VERIFY_TOKEN=
# The pages to receive leads from: pageId:pageAccessToken pairs, comma-separated.
# Use a long-lived page token (from a system user, or exchanged from a
# long-lived user token) with leads_retrieval, pages_manage_metadata,
# pages_show_list and pages_read_engagement. Never commit a real token.
META_PAGE_ACCESS_TOKENS=
META_GRAPH_API_VERSION=v23.0
META_GRAPH_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Retention
# ---------------------------------------------------------------------------
# Days after which closed and spam enquiries are deleted by the purge routine.
# Under UK GDPR Art. 5(1)(e) this must match the retention period published in
# the privacy notice — see RETENTION_PERIOD in the frontend's lib/contact.ts,
# which is still unset.
ENQUIRY_RETENTION_DAYS=365

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# Set to a THROWAWAY database to run the integration suite; it truncates the
# enquiries table before every test. Unset, those tests are skipped.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evc_test
